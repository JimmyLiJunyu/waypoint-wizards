generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model Follow {
  followerId String
  followingId String
  status FollowStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  follower User @relation("UserFollowing", fields: [followingId], references: id, onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followerId], references: id, onDelete: Cascade)
  @@id([followerId, followingId])
}

model User {
  id         String         @id @default(uuid())
  email      String         @unique
  name       String?
  imageUrl   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  password   String
  itinearies Collaborator[]

  // relations for following system
  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")
}

model Destination {
  id          Int       @id @default(autoincrement())
  placeName   String
  arrival     DateTime
  departure   DateTime
  position    Float
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

model Itinerary {
  id            String         @id @default(uuid())
  title         String
  createdAt     DateTime       @default(now())
  location      String
  startDate     DateTime
  endDate       DateTime
  collaborators Collaborator[]
  destinations  Destination[]
  itineraryItems ItineraryItem[]
}

model Collaborator {
  id          Int       @id @default(autoincrement())
  role        String    @default("EDITOR")
  userId      String
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, itineraryId])
}

model ItineraryItem {
  id          Int      @id @default(autoincrement())
  dayNumber   Int
  position    Int      // order of attractions
  placeId     String
  name        String
  address     String
  lat         Float
  lng         Float
  rating      Float
  reviews     Int
  instanceId  String   // the client-side instanceId

  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}